# =============================================================================
# DevStackIO Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Site Configuration ---
# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://tools.devstackio.com

# Contact email displayed on the contact page
NEXT_PUBLIC_CONTACT_EMAIL=contact@devstackio.com

# --- Analytics & Ads ---
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# Leave empty to disable analytics
# Baked into public/analytics-init.js at build by scripts/prebuild.mjs
NEXT_PUBLIC_GA_ID=

# Google AdSense Publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# Leave empty to disable ads
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=

# Google AdSense Ad Slot IDs — one per placement. Each must be a real slot ID
# from your AdSense account. Leave empty to disable that placement; ads will
# not render (and no broken ad request is sent) until a real ID is provided.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MID=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_TOOLS_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_TOOLS_MID=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_MID=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_INCONTENT_1=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_INCONTENT_2=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# --- Server Configuration ---
# Server port (default: 3000)
PORT=3000

# --- Rate Limiting ---
# Set to 'true' when behind a reverse proxy with its own rate limiting
# WARNING: Disabling rate limiting removes application-level DoS protection
# DISABLE_RATE_LIMIT=true

# --- IndexNow ---
# 8-128 chars of [A-Za-z0-9-]. When set, prebuild auto-generates
# public/{KEY}.txt (ownership verification file) and scripts/sitemap-submitter.mjs
# (npm run sitemap:submit / seo:audit:submit) notifies Bing, Yandex, Seznam,
# Naver, Amazon, and Yep via api.indexnow.org. Generate a key at
# https://www.indexnow.org.
# Example: INDEXNOW_KEY=a1b2c3d4e5f6478890aabbccddeeff01
INDEXNOW_KEY=

# --- Sitemap submitter state ---
# Absolute path to a JSON file the sitemap submitter uses to remember the
# last hash + last submission date. Set this to a path that survives
# deploys (e.g. /var/www/tools/data/sitemap-state.json) so submissions are
# skipped on unchanged sitemaps instead of repeating every deploy.
# Default: <cwd>/data/sitemap-state.json (gitignored; wiped on `git reset`).
# SITEMAP_STATE_PATH=

# --- Search Engine Verification ---
# Verification tokens for Google Search Console and Bing Webmaster.
# Get them from the verification page of each console, then paste the value.
# When empty, no verification meta tag is rendered.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=

# --- Visit Counter ---
# Session length (in minutes) before a return counts as a new visit (default: 30)
VISIT_SESSION_MINUTES=30
# Absolute path to the persistent visit-counter log. This must point to a
# directory that survives deploys (repo data/ is preserved by the deploy
# workflow). Default: <cwd>/data/visit-counter/visits.jsonl
# Example: VISIT_COUNTER_PATH=/var/www/tools/data/visit-counter/visits.jsonl
VISIT_COUNTER_PATH=

# --- Security ---
# Salt used for hashing IP addresses in security logging.
# REQUIRED IN PRODUCTION. The build will fail if this is not set in production.
# Generate with: openssl rand -hex 32
# Example: IP_HASH_SALT=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6
IP_HASH_SALT=

# If your reverse proxy (Nginx) handles rate limiting, set to 'true' to disable
# application-level rate limiting.
# DISABLE_RATE_LIMIT=true
