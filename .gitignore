# See https://help.github.com/articles/ignoring-files/ for more information about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/.playwright-mcp/

# playwright snapshots
tests/*-snapshots/
/homepage.md
# turbo
.turbo/

# next.js
/.next/
/out/

# production
/build
/logs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# runtime error logs (server-side, may contain hashed security events)
/server.err

# npm
.npmrc
deploymentfailed.txt
# env files
.env
.env.local
.env.*.local
.env.development
.env.staging
.env.staging.local

# runtime state (sitemap submitter, form submissions)
/data/*
!/data/.gitkeep
!/data/submissions/
!/data/submissions/.gitkeep
!/data/release.json
!/data/build-number.json
!/data/releases/
!/data/releases/*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated version data
src/lib/version/__generated__/

# eslint
.eslintcache

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# misc
*.pem
.opencode/

# nginx (keep production config private, use .example)
/nginx/nginx.prod.conf

# nginx CSP hash map (auto-generated by scripts/postbuild-csp.mjs)
/nginx/csp.generated.conf

# build-generated same-origin analytics init (GA ID baked at build by scripts/prebuild.mjs)
/public/analytics-init.js

# production readiness reports
/data/production-readiness/
/data/seo-reports/

# env files (explicit catch-all for production)
.env.production

# wasm build output
/wasm/pkg/
/wasm/target/
/src/lib/wasm/pkg/

# suggestions / notes
suggestions.md
SEO.md

/deploy
/crawl
/suggestions
/SSH
SSH/
docs/suggestions/upgrade.md

# OG image review artifacts (regenerate with docs/suggestions/download-og-images.mjs)
docs/suggestions/og-images/







